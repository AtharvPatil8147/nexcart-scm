# ══════════════════════════════════════════════════════════════════
# NexCart — Environment Variables
# Copy this file to .env and fill in your real values
# ══════════════════════════════════════════════════════════════════

# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net    # Atlas connection string (or local: mongodb://localhost:27017)
MONGODB_DB_NAME=nexcart                                              # Database name used by the app

# ── AWS Bedrock ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key                                # IAM user access key for Bedrock
AWS_SECRET_ACCESS_KEY=your_aws_secret_key                            # IAM user secret key for Bedrock
AWS_REGION=us-east-1                                                 # AWS region where Bedrock is enabled
BEDROCK_MODEL_ID=anthropic.claude-opus-4-5                       # Bedrock model ID (claude-opus-4-5 or claude-3-5-sonnet-v2)

# ── AWS EventBridge ───────────────────────────────────────────────
EVENTBRIDGE_BUS_NAME=nexcart-events                                  # Custom EventBridge bus name
EVENTBRIDGE_SOURCE=com.nexcart.signals                               # Event source identifier for NexCart events

# ── External Signal APIs ──────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key                                        # API key from newsapi.org (free tier available)
OPENWEATHER_API_KEY=your_openweathermap_key                          # API key from openweathermap.org
MARINE_TRAFFIC_API_KEY=your_marinetraffic_key                        # API key from marinetraffic.com (or use mock)

# ── Notifications ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com                                             # SMTP server hostname for email notifications
SMTP_PORT=587                                                        # SMTP server port (587 for TLS)
SMTP_USER=your_email@gmail.com                                       # SMTP login email address
SMTP_PASSWORD=your_app_password                                      # SMTP app password (not your Gmail password)
FIREBASE_SERVER_KEY=your_firebase_server_key                         # Firebase Cloud Messaging server key for push notifications

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development                                                  # Environment: development | staging | production
APP_SECRET_KEY=change_this_to_a_random_string                        # Secret key for session signing / JWT
FRONTEND_URL=http://localhost:5173                                   # Frontend origin (used for CORS)
BACKEND_PORT=8000                                                    # Port the FastAPI server listens on
SIGNAL_POLL_INTERVAL_SECONDS=300                                     # How often (in seconds) the disruption agent polls for signals
